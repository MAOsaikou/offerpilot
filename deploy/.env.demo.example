# 生产脚本模板：deploy.sh init 生成根 .env（600），自动生成密码与密钥。
# deploy.sh 固定加载 production 覆盖：认证 SeaweedFS；默认开发 Compose 仍为 S3Mock。
DOMAIN=demo.example.com
COMPOSE_PROJECT_NAME=offerpilot-prod
TAG=demo
# 部署后探针地址；HTTP 本机验收可用 DOMAIN=http://demo.offerpilot.test。
PUBLIC_URL=https://demo.example.com
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=https://demo.example.com
HTTP_PORT=80
HTTPS_PORT=443
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
JOBS_MCP_HOST_PORT=7001
POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=replace-with-random-password
REDIS_PASSWORD=replace-with-random-password
# openssl rand -base64 64（合并换行）；openssl rand -base64 32
JWT_SECRET=replace-with-at-least-64-random-bytes
DATA_ENCRYPTION_KEY=replace-with-base64-32-random-bytes
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=replace-with-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-storage-secret-key
MINIO_BUCKET=offerpilot
# 当前上传/下载由后端认证 API 中转，不公开 S3/Filer/控制台端口。
MINIO_PUBLIC_ENDPOINT=https://demo.example.com
DEMO_ACCOUNT_ENABLED=true
# 公网默认每次登录创建独立沙箱；本机录屏才设 false 使用共享账号。
DEMO_SANDBOX_ENABLED=true
DEMO_SANDBOX_TTL=24h
DEMO_SANDBOX_DAILY_TOKEN_LIMIT=200000
DEMO_SANDBOX_MAX_ACTIVE=30
DEMO_SANDBOX_MAX_PER_DAY=100
DEMO_SANDBOX_CLEANUP_DELAY_MS=60000
AUTH_DEMO_LOGIN_PER_MINUTE=5
# 以下密码/邮箱仅共享录屏模式或 STAFF 手动 reset 使用。
DEMO_ACCOUNT_EMAIL=demo@offerpilot.local
DEMO_ACCOUNT_PASSWORD=replace-with-random-demo-password
# Spring 六字段 cron，后端时区（容器默认 UTC）；'-' 禁用。与 host cron 二选一。
DEMO_RESET_CRON="0 0 4 * * *"
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DEEPSEEK_API_KEY=
LLM_DEFAULT_TIER=FLASH
# 生产镜像没有 LLM_MOCK 实现；不要通过启用 mock 绕过真实模型验收。
# 有百炼 embedding key 再开启，未配置时保留全文/规则回退。
OCCUPATION_EMBED_ENABLED=false
NOTES_EMBED_ENABLED=false
LLM_EMBEDDING_PROVIDER=none
JOBS_MCP_URL=http://jobs-mcp:7001
# 离线回退明确标注为示例快照；LIVE / LOCAL / AUTO
JOBS_SOURCE_MODE=AUTO
JOBS_LIVE_TIMEOUT_MS=10000
MCP_SERVER_ENABLED=false
MCP_SERVER_API_KEY=
