# This is the first public proxy: do not trust any client forwarding headers.
(proxy_headers) {
    header_up -Forwarded
    header_up -X-Forwarded-*
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Host {hostport}
    header_up X-Forwarded-Proto {scheme}
}

{$DOMAIN} {
    # Do not compress SSE: each event must reach the browser immediately.

    request_body {
        max_size 13MB
    }

    handle /healthz {
        respond "ok" 200
    }

    @sse path /sse /api/v1/agent/chat /api/v1/agent/runs/* /api/v1/*/analyze /api/v1/*/optimize /api/v1/interviews/* /api/v1/discovery/recommendations /api/v1/career/*
    handle @sse {
        reverse_proxy backend:8081 {
            flush_interval -1
            import proxy_headers
            transport http {
                dial_timeout 10s
                response_header_timeout 240s
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    handle /api/* {
        reverse_proxy backend:8081 {
            import proxy_headers
            transport http {
                dial_timeout 10s
                response_header_timeout 240s
                read_timeout 240s
                write_timeout 240s
            }
        }
    }
    handle /mcp* {
        reverse_proxy backend:8081 {
            import proxy_headers
            flush_interval -1
        }
    }
    handle /actuator/health {
        reverse_proxy backend:8081 {
            import proxy_headers
        }
    }
    handle /swagger-ui* {
        reverse_proxy backend:8081 {
            import proxy_headers
        }
    }
    handle /v3/api-docs* {
        reverse_proxy backend:8081 {
            import proxy_headers
        }
    }

    handle {
        encode zstd gzip
        root * /srv/frontend
        try_files {path} /index.html
        file_server
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache"
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), microphone=(self)"
    }
}

# Container-only readiness listener; port 8080 is not published to the host.
http://:8080 {
    respond /healthz "ok" 200
}
