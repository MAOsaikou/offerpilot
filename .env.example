# =============================================================================
# OfferPilot 环境变量模板（后端 + Docker Compose）
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 生成随机串：openssl rand -base64 64（JWT）/ openssl rand -base64 32（加密密钥）
# =============================================================================

# ----- 部署 -----
# 公网演示域名；本地开发填 localhost（Caddy 将使用自签名证书）
DOMAIN=localhost
# 镜像标签（CI 部署时覆盖）
TAG=latest
# 宿主机端口；数据服务固定绑定 127.0.0.1，容器内端口不变。
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
JOBS_MCP_HOST_PORT=7001
HTTP_PORT=80
HTTPS_PORT=443
# 前端构建期 API 地址：同域部署用 /api/v1；前后端分离部署填完整 URL
VITE_API_BASE_URL=/api/v1
# 允许的跨域来源（逗号分隔），前端与后端同域时可留空
CORS_ORIGINS=

# ----- PostgreSQL（pgvector/pgvector:pg17）-----
POSTGRES_HOST=postgres
POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=change-me-postgres

# ----- Redis -----
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis

# ----- 对象存储（Compose 服务名 minio，镜像为 Adobe S3Mock）-----
# 警告：S3Mock 仅供本地开发 / 演示；下面的凭据由后端用于签名，但 S3Mock 不校验、不执行认证。
# 非 localhost、共享或生产部署必须换成强制验证 access key + secret 的 S3 兼容存储。
# 替换步骤见 docs/09-部署与运维.md §2.1 与 deploy/docker-compose.storage-auth.example.yml。
# 容器内 S3 API 为 9000；宿主机必须保持 127.0.0.1:9000 绑定，不得公开 9000；没有 9001 控制台。
MINIO_ROOT_USER=offerpilot
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
MINIO_BUCKET=offerpilot
# 容器内访问地址
MINIO_ENDPOINT=http://minio:9000
# 浏览器可访问的地址，用于签名 URL（本机为 http://127.0.0.1:9000）
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# ----- 安全 -----
# JWT 签名密钥，至少 64 字节随机串
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
# 32 字节 base64，用于加密用户第三方 Token（GitHub 等）
DATA_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ----- 大模型（DeepSeek：聊天、规划与简历解析）-----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 聊天仅两档：FLASH「快速」、PRO「深度」；默认 FLASH。
LLM_PROVIDER_FLASH=deepseek
LLM_MODEL_FLASH=deepseek-flash
LLM_PROVIDER_PRO=deepseek
LLM_MODEL_PRO=deepseek-v4-pro
LLM_DEFAULT_TIER=FLASH
# SC-01 overlaps generation but gates all model output and tool/memory effects until screening finishes.
AGENT_PARALLEL_SAFETY_SCREEN=true
# At most one RESUME/JOB action-model prefetch after complete planner routing fields.
AGENT_EARLY_EXPERT_HANDOFF=true
# DeepSeek 思考模式 enabled | disabled；工具调用轮次始终 disabled（Spring AI 1.0 兼容）。
LLM_THINKING_FLASH=disabled
LLM_THINKING_PRO=enabled
# 包含思考和正文的输出预算；深度档需为正文保留足够空间。
LLM_MAX_TOKENS_FLASH=8192
LLM_MAX_TOKENS_PRO=32768
# Flash 支持图片，Pro 仅文字；内部视觉路由保持 Flash。
LLM_VISION_FLASH=true
LLM_VISION_PRO=false
LLM_VISION_PROVIDER=deepseek
LLM_MODEL_VISION_ALT=deepseek-flash
LLM_THINKING_VISION_ALT=disabled
LLM_MAX_TOKENS_VISION_ALT=8192
# CHEAP 档已移除；旧 CHEAP / ECONOMY / 经济 / BALANCED 请求和偏好映射到 FLASH。
# LLM_MODEL_CHEAP / LLM_PROVIDER_CHEAP / LLM_VISION_CHEAP 已移除，设置时启动告警并忽略。

# ----- 百炼：Embedding / Rerank，或可选聊天供应商 -----
# DeepSeek 无 embeddings 接口。未配置百炼 Key 时 RAG 保留全文检索与规则推荐。
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_MODEL_EMBEDDING=text-embedding-v4
# 私有笔记保存不等待向量；缺 Key 时仅用全文检索，后台每批最多 8 条。
NOTES_EMBED_ENABLED=true
NOTES_EMBED_DELAY_MS=30000
LLM_MODEL_RERANK=gte-rerank
LLM_EMBEDDING_DIMENSIONS=1024
# 免费本地向量（无需百炼）：Ollama 运行 BAAI bge-m3（1024 维，与库表一致），embedding 单独指向它，聊天不受影响。
#   docker run -d --name ollama -p 127.0.0.1:11434:11434 -v ollama:/root/.ollama ollama/ollama
#   docker exec ollama ollama pull bge-m3
# EMBEDDING_BASE_URL=http://localhost:11434   # 容器内后端用 http://host.docker.internal:11434
# EMBEDDING_API_KEY=ollama                     # Ollama 不校验，填任意非空值
# LLM_MODEL_EMBEDDING=bge-m3
# 切换模型后启动时自动清空旧向量并重建（embedding_index_state 记录当前模型）。
# 可选：LLM_PROVIDER_FLASH=bailian + LLM_MODEL_FLASH=<百炼模型>（图片能力需同时调整）。
# PRO 同样支持 LLM_PROVIDER_PRO=bailian/custom，不向这些供应商发送 DeepSeek thinking 字段。

# 每用户每日 token 上限
LLM_DAILY_TOKEN_LIMIT=200000
# 兼容保留变量；当前生产/dev 启动不读取，mock embedding 仅供测试，不能替代真实模型验收
LLM_MOCK=false

# ----- MCP 客户端 -----
# 自建岗位 MCP（Node，包装企业官网公开招聘接口）
JOBS_MCP_URL=http://jobs-mcp:7001
# AUTO：官网失败/超时自动回退示例快照；LIVE：仅官网；LOCAL：不调用网络
# 旧 ALL / 未知值按 AUTO 处理并警告
JOBS_SOURCE_MODE=AUTO
# 整次官网/MCP 调用预算（毫秒），默认 10 秒
JOBS_LIVE_TIMEOUT_MS=10000
# 搜索 MCP（可选，博查 / Tavily 等 Streamable HTTP 服务）
SEARCH_MCP_URL=
SEARCH_MCP_API_KEY=
# GitHub 官方远程 MCP（用户 Token 在设置页录入并加密存储）
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# ----- MCP 服务端（SSE /sse + /mcp/message；默认关闭）-----
MCP_SERVER_ENABLED=false
MCP_SERVER_API_KEY=

# ----- 校招日历数据源（公开聚合 JSON）-----
CAMPUS_CALENDAR_SOURCE_URL=https://raw.githubusercontent.com/xixicc2027/jobs.json/main/jobs.json
CAMPUS_CALENDAR_SYNC_CRON=0 0 6 * * *

# ----- 共享虚构体验账号（POST /api/v1/auth/demo-login）-----
# 启用且密码有效时，启动自动创建 USER 并在无简历时灌入完整演示旅程。
# 密码只从环境注入（至少 6 位、UTF-8 最多 72 字节），留空则跳过并返回 403。
# 共享体验账号视为公开账号；请定期轮换密码，不复用任何真实用户/客服密码。
# 一键登录无需向浏览器提供密码；关闭公众入口请设置 enabled=false。
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_EMAIL=demo@offerpilot.local
DEMO_ACCOUNT_PASSWORD=
# 按后端服务器时区执行；设置为 - 可禁用定时重置。
DEMO_RESET_CRON="0 0 4 * * *"
AUTH_DEMO_LOGIN_PER_MINUTE=20

# ----- 可观测（可选）-----
SENTRY_DSN=
LOG_LEVEL=INFO

# ----- 部署（GitHub Actions Secrets，仅作提示，不在此填写）-----
# DEPLOY_HOST / DEPLOY_USER / DEPLOY_SSH_KEY

# 网页「设置 → 模型选择」文字使用快速 / 深度，图片可选内部视觉备选；配置供应商后重启一次后端。
# 供应商可为 deepseek、bailian、custom；模型名须由对应供应商支持。
# 示例：将快捷档位连接到自定义 OpenAI 兼容服务（按需取消注释）。
# LLM_PROVIDER_FLASH=custom
# LLM_MODEL_FLASH=your-model-name
# LLM_VISION_FLASH=true
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_COMPLETIONS_PATH=/v1/chat/completions
# 深度档同样支持 LLM_PROVIDER_PRO；视觉供应商用 LLM_VISION_PROVIDER。
# 图像能力开关：LLM_VISION_FLASH / LLM_VISION_PRO / LLM_VISION_VISION_ALT。
# 不支持图片的模型务必设为 false，避免在网页被选作视觉模型。

# 首次客服 bootstrap：仅在 users 中没有任何 STAFF 时使用；共享环境首启后移除或留空。
# STAFF_BOOTSTRAP_EMAIL=
# STAFF_BOOTSTRAP_PASSWORD=
