# =============================================================================
# OfferPilot 前端环境变量模板（Vite）
# 复制为 .env.local 使用；以 VITE_ 开头的变量会被打包进浏览器，禁止放任何密钥。
# =============================================================================

# 后端 API 基地址：本地开发指向后端端口；生产同域部署用 /api/v1
VITE_API_BASE_URL=http://localhost:8081/api/v1

# 应用显示名
VITE_APP_NAME=OfferPilot 职航

# Mock 数据（MSW）：开发环境默认开启，后端联调时设为 false
VITE_ENABLE_MOCK=true

# 功能开关
# 面试室端侧表现分析（MediaPipe，摄像头）
VITE_ENABLE_CAMERA_ANALYSIS=true
# 语音面试（Web Speech API）
VITE_ENABLE_VOICE=true
# 显示 Agent 思考摘要（reasoning.delta）
VITE_ENABLE_REASONING_PANEL=true

# MediaPipe 模型与 wasm 资源地址：默认使用 public/mediapipe/；可改为 CDN
VITE_MEDIAPIPE_ASSETS_URL=/mediapipe

# 错误上报（可选）
VITE_SENTRY_DSN=

# 开发代理（vite.config.ts 读取，用于 /api 转发到后端，避免 CORS）
VITE_DEV_PROXY_TARGET=http://localhost:8081
