# 复制到 .env.local 后填写本机环境；勿提交真实凭据。
# JWT_SECRET 必须为至少 64 字节的随机串；生成方法见 backend/README.md。
JWT_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_CHEAP=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
POSTGRES_HOST=localhost
POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=
REDIS_HOST=localhost
REDIS_PASSWORD=
# Auth: all POST attempts per IP in independent 60-second windows (positive integers).
# Redis shares counters across instances; absent Redis uses process-local memory (tests).
# Trusted proxy required with forward-headers-strategy=framework: strip/overwrite
# incoming Forwarded and X-Forwarded-* headers before forwarding to the app.
AUTH_GUEST_PER_MINUTE=15
AUTH_LOGIN_PER_MINUTE=20
AUTH_REGISTER_PER_MINUTE=20
AUTH_STAFF_LOGIN_PER_MINUTE=20
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=offerpilot
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=offerpilot
