# Copy to backend/.env.local. Loaded by the dev profile from repo root or backend.
# This file is committed: never put a real key here, use a placeholder only.
# Never put these values in frontend/VITE_* variables.
DEEPSEEK_API_KEY=sk-not-configured
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_CHEAP=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# 文字与图片默认共用 DeepSeek Key；切换百炼时同时修改供应商和视觉模型名。
LLM_VISION_PROVIDER=deepseek
LLM_MODEL_VISION_ALT=deepseek-flash
# 可选百炼供应商（LLM_VISION_PROVIDER=bailian）。
BAILIAN_API_KEY=sk-not-configured
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# Match deploy/docker-compose.yml defaults; change together if customized.
# minio 服务是 Adobe S3Mock：本机 API 为 127.0.0.1:9000，没有 9001 控制台。
# 容器不校验访问密钥；后端仍用 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 签名。
POSTGRES_HOST=localhost
POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=change-me-postgres
REDIS_HOST=localhost
REDIS_PASSWORD=change-me-redis
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=offerpilot
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
MINIO_BUCKET=offerpilot
JOBS_MCP_URL=http://localhost:7001

# 网页「设置 → 模型选择」从四个档位中选择；配置供应商后重启一次后端。
# 供应商可为 deepseek、bailian、custom；模型名须由对应供应商支持。
# 示例：将快捷档位连接到自定义 OpenAI 兼容服务（按需取消注释）。
# LLM_PROVIDER_FLASH=custom
# LLM_MODEL_FLASH=your-model-name
# LLM_VISION_FLASH=true
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_COMPLETIONS_PATH=/v1/chat/completions
# 其他档位同样支持 LLM_PROVIDER_CHEAP / LLM_PROVIDER_PRO；视觉供应商用 LLM_VISION_PROVIDER。
# 图像能力开关：LLM_VISION_FLASH / LLM_VISION_CHEAP / LLM_VISION_PRO / LLM_VISION_VISION_ALT。
# 不支持图片的模型务必设为 false，避免在网页被选作视觉模型。
