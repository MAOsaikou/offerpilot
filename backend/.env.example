# 复制到 .env.local 后填写本机环境；勿提交真实凭据。
# JWT_SECRET 必须为至少 64 字节的随机串；生成方法见 backend/README.md。
JWT_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_CHEAP=deepseek-flash
# 模型配额：每次供应商调用消耗一次 RPM（包含规划/重试），UTC 日窗口。
# 登录用户日额度优先使用 user_preferences.daily_token_limit；缺行才使用默认。
# 访客始终使用访客额度；PRO 仅允许非访客认证用户。并发运行配置保持独立。
LLM_PER_USER_PER_MINUTE=60
LLM_GUEST_PER_USER_PER_MINUTE=20
LLM_DEFAULT_DAILY_TOKEN_LIMIT=200000
LLM_GUEST_DAILY_TOKEN_LIMIT=50000
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
POSTGRES_HOST=localhost
POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=
REDIS_HOST=localhost
REDIS_PASSWORD=
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=offerpilot
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=offerpilot
