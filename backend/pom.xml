<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.offerpilot</groupId>
    <artifactId>offerpilot-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>OfferPilot Backend Parent</name>
    <description>OfferPilot backend multi-module Maven parent</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <springdoc.version>2.6.0</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <minio.version>8.5.17</minio.version>
        <tika.version>3.2.2</tika.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <ulid.version>5.2.3</ulid.version>
        <bucket4j.version>8.14.0</bucket4j.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- JDK 25 local toolchain: Mockito/Byte Buddy needs experimental until upgraded -->
        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
        <!-- Paid evaluations and live dump helpers are always opt-in. -->
        <offerpilot.live-test-exclude>**/*Live*.java</offerpilot.live-test-exclude>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>offerpilot-platform</module>
        <module>offerpilot-agent</module>
        <module>offerpilot-identity</module>
        <module>offerpilot-resume</module>
        <module>offerpilot-job</module>
        <module>offerpilot-career</module>
        <module>offerpilot-interview</module>
        <module>offerpilot-bootstrap</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <testExcludes>
                            <testExclude>${offerpilot.live-test-exclude}</testExclude>
                        </testExcludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito/Byte Buddy must also support developer machines running JDK 25. -->
                        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                        <excludes>
                            <exclude>${offerpilot.live-test-exclude}</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>essential-test</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <configuration>
                                <!-- Keep compilation small as well as execution. No Spring Boot or Docker suites. -->
                                <testIncludes>
                                    <testInclude>**/PiiMaskerTest.java</testInclude>
                                    <testInclude>**/PiiGatewayTransportTest.java</testInclude>
                                    <testInclude>**/DeepSeekGatewayTest.java</testInclude>
                                    <testInclude>**/McpApiKeyFilterTest.java</testInclude>
                                    <testInclude>**/AuthRateLimiterTest.java</testInclude>
                                    <testInclude>**/LlmQuotaLimiterTest.java</testInclude>
                                    <testInclude>**/SseWriterTest.java</testInclude>
                                    <testInclude>**/SafetyScreensTest.java</testInclude>
                                    <testInclude>**/ScreenedGenerationTest.java</testInclude>
                                    <testInclude>**/JwtTokenServiceTest.java</testInclude>
                                    <testInclude>**/PasswordLoginServiceTest.java</testInclude>
                                    <testInclude>**/OrchestratorTest.java</testInclude>
                                    <testInclude>**/ChatServiceTest.java</testInclude>
                                    <testInclude>**/BoardApprovalTest.java</testInclude>
                                    <testInclude>**/InterviewApprovalTest.java</testInclude>
                                    <testInclude>**/CareerApprovalTest.java</testInclude>
                                    <testInclude>**/CoachApprovalTest.java</testInclude>
                                    <testInclude>**/ResumePatchApprovalTest.java</testInclude>
                                    <testInclude>**/MemoryChatTest.java</testInclude>
                                    <testInclude>**/ToolSafetyExecutionTest.java</testInclude>
                                    <testInclude>**/ResumePatchesTest.java</testInclude>
                                    <testInclude>**/ResumeDiagnosisTest.java</testInclude>
                                    <testInclude>**/ResumeOptimizerTest.java</testInclude>
                                    <testInclude>**/JobMatcherTest.java</testInclude>
                                    <testInclude>**/JobMatchDeadlineTest.java</testInclude>
                                    <testInclude>**/JobPageFetcherPinningTest.java</testInclude>
                                    <testInclude>**/EmbeddingPrivacyTest.java</testInclude>
                                    <testInclude>**/CoachPlanForChatTest.java</testInclude>
                                    <testInclude>**/InterviewServiceTest.java</testInclude>
                                    <testInclude>**/InterviewValidationTest.java</testInclude>
                                    <testInclude>**/ControllerIdentityArchitectureTest.java</testInclude>
                                    <testInclude>**/RequestValidationTest.java</testInclude>
                                    <testInclude>**/AccountDataDeletionServiceTest.java</testInclude>
                                    <testInclude>**/UserDataInventoryTest.java</testInclude>
                                    <testInclude>**/DevEmbeddingConfigurationTest.java</testInclude>
                                </testIncludes>
                            </configuration>
                        </plugin>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <!-- Also constrain discovery when a previous full/live compile left class files. -->
                                <includes>
                                    <include>**/PiiMaskerTest.java</include>
                                    <include>**/PiiGatewayTransportTest.java</include>
                                    <include>**/DeepSeekGatewayTest.java</include>
                                    <include>**/McpApiKeyFilterTest.java</include>
                                    <include>**/AuthRateLimiterTest.java</include>
                                    <include>**/LlmQuotaLimiterTest.java</include>
                                    <include>**/SseWriterTest.java</include>
                                    <include>**/SafetyScreensTest.java</include>
                                    <include>**/ScreenedGenerationTest.java</include>
                                    <include>**/JwtTokenServiceTest.java</include>
                                    <include>**/PasswordLoginServiceTest.java</include>
                                    <include>**/OrchestratorTest.java</include>
                                    <include>**/ChatServiceTest.java</include>
                                    <include>**/BoardApprovalTest.java</include>
                                    <include>**/InterviewApprovalTest.java</include>
                                    <include>**/CareerApprovalTest.java</include>
                                    <include>**/CoachApprovalTest.java</include>
                                    <include>**/ResumePatchApprovalTest.java</include>
                                    <include>**/MemoryChatTest.java</include>
                                    <include>**/ToolSafetyExecutionTest.java</include>
                                    <include>**/ResumePatchesTest.java</include>
                                    <include>**/ResumeDiagnosisTest.java</include>
                                    <include>**/ResumeOptimizerTest.java</include>
                                    <include>**/JobMatcherTest.java</include>
                                    <include>**/JobMatchDeadlineTest.java</include>
                                    <include>**/JobPageFetcherPinningTest.java</include>
                                    <include>**/EmbeddingPrivacyTest.java</include>
                                    <include>**/CoachPlanForChatTest.java</include>
                                    <include>**/InterviewServiceTest.java</include>
                                    <include>**/InterviewValidationTest.java</include>
                                    <include>**/ControllerIdentityArchitectureTest.java</include>
                                    <include>**/RequestValidationTest.java</include>
                                    <include>**/AccountDataDeletionServiceTest.java</include>
                                    <include>**/UserDataInventoryTest.java</include>
                                    <include>**/DevEmbeddingConfigurationTest.java</include>
                                </includes>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
        <profile>
            <!-- Explicit activation disables essential-test and restores all offline tests, including Docker suites. -->
            <id>full-test</id>
        </profile>
        <profile>
            <!-- A targeted -Dtest invocation must compile the requested class even outside the default list. -->
            <id>selected-test</id>
            <activation>
                <property>
                    <name>test</name>
                </property>
            </activation>
        </profile>
        <profile>
            <id>live</id>
            <properties>
                <!-- Compile/discover live tests; their per-suite env/key gates still apply. -->
                <offerpilot.live-test-exclude>**/__no_live_test_exclusions__.java</offerpilot.live-test-exclude>
            </properties>
        </profile>
    </profiles>
</project>
