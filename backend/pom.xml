<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.offerpilot</groupId>
    <artifactId>offerpilot-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>OfferPilot Backend Parent</name>
    <description>OfferPilot backend multi-module Maven parent</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <springdoc.version>2.6.0</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <minio.version>8.5.17</minio.version>
        <tika.version>3.2.2</tika.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <ulid.version>5.2.3</ulid.version>
        <bucket4j.version>8.14.0</bucket4j.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- JDK 25 local toolchain: Mockito/Byte Buddy needs experimental until upgraded -->
        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
        <!-- Keep paid/deep smoke sources out of the default test compilation and discovery. -->
        <offerpilot.live-test-exclude>**/*LiveEvaluation*.java</offerpilot.live-test-exclude>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>offerpilot-platform</module>
        <module>offerpilot-agent</module>
        <module>offerpilot-identity</module>
        <module>offerpilot-resume</module>
        <module>offerpilot-job</module>
        <module>offerpilot-career</module>
        <module>offerpilot-interview</module>
        <module>offerpilot-bootstrap</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <testExcludes>
                            <testExclude>${offerpilot.live-test-exclude}</testExclude>
                        </testExcludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito/Byte Buddy must also support developer machines running JDK 25. -->
                        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                        <excludes>
                            <exclude>${offerpilot.live-test-exclude}</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>live</id>
            <properties>
                <!-- Compile/discover live tests; their per-suite env/key gates still apply. -->
                <offerpilot.live-test-exclude>**/__no_live_test_exclusions__.java</offerpilot.live-test-exclude>
            </properties>
        </profile>
    </profiles>
</project>
